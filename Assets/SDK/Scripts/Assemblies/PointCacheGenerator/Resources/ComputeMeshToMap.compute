#pragma kernel TransferDataBoth
#pragma kernel TransferDataPosition
#pragma kernel TransferDataNormal

uint VertexCount;
uint2 TextureSize;

StructuredBuffer<float3> PositionBuffer;
StructuredBuffer<float3> NormalBuffer;

RWTexture2D<float4> PositionMap;
RWTexture2D<float4> NormalMap;

// Hash function from H. Schechter & R. Bridson, goo.gl/RXiKaH
uint Hash(uint s)
{
    s ^= 2747636419u;
    s *= 2654435769u;
    s ^= s >> 16;
    s *= 2654435769u;
    s ^= s >> 16;
    s *= 2654435769u;
    return s;
}

[numthreads(8, 8, 1)]
void TransferDataBoth(uint3 id : SV_DispatchThreadID)
{
    uint linearIndex = id.x + id.y * TextureSize.x;
    
    // Clamp to vertex count to avoid out-of-bounds
    if (linearIndex >= VertexCount)
    {
        PositionMap[id.xy] = float4(0, 0, 0, 0);
        NormalMap[id.xy] = float4(0, 0, 0, 0);
        return;
    }
    
    uint i = Hash(linearIndex) % VertexCount;
    
    float3 p1 = PositionBuffer[i];
    float3 n1 = NormalBuffer[i];
    
    PositionMap[id.xy] = float4(p1, 1);
    NormalMap[id.xy] = float4(n1, 0);
}

[numthreads(8, 8, 1)]
void TransferDataPosition(uint3 id : SV_DispatchThreadID)
{
    uint linearIndex = id.x + id.y * TextureSize.x;
    
    // Clamp to vertex count to avoid out-of-bounds
    if (linearIndex >= VertexCount)
    {
        PositionMap[id.xy] = float4(0, 0, 0, 0);
        return;
    }
    
    uint i = Hash(linearIndex) % VertexCount;
    
    float3 p1 = PositionBuffer[i];
    
    PositionMap[id.xy] = float4(p1, 1);
}

[numthreads(8, 8, 1)]
void TransferDataNormal(uint3 id : SV_DispatchThreadID)
{
    uint linearIndex = id.x + id.y * TextureSize.x;
    
    // Clamp to vertex count to avoid out-of-bounds
    if (linearIndex >= VertexCount)
    {
        NormalMap[id.xy] = float4(0, 0, 0, 0);
        return;
    }
    
    uint i = Hash(linearIndex) % VertexCount;
    
    float3 n1 = NormalBuffer[i];
    
    NormalMap[id.xy] = float4(n1, 0);
}
