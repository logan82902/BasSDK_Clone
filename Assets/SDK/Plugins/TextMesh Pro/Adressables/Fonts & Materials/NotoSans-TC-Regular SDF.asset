    characterSetSelectionMode: 7
    characterSequence: "\u4F60\u5728\u6B98\u7834\u7684\u8239\u4E0A\u9192\u4F86\u3002\u5468\u570D\u6C34\u57DF\u5F88\u5371\u96AA\uFF0C\u597D\u4E0D\u5BB9\u6613\u624D\u5230\u5CF6\u660F\u6C89\u4E2D\u5E7E\u4E4E\u5FD8\u4E86\u662F\u4EC0\u9EBC\u628A\u5E36\u9019\u88E1\u9AB8\u641C\u5C0B\u4F3C\u500B\u932F\u8D77\u9EDE\u53EF\u96A8\u6642\u958B\u555F\u9078\u55AE\u6AA2\u67E5\u8F38\u5165\u914D\u7F6E\u3001\u8B8A\u66F4\u9805\u6216\u96E2\u8A72\u5340\u6309\u4E0B\u9215\u5373\u6253\u518D\u76F8\u540C\u95DC\u9589\u4F7F\u7528\u5DE6\u6416\u687F\u56DB\u8655\u79FB\u52D5\u53F3\u8F49\u5411\u5FEB\u901F\u80FD\u5F15\u5641\u5FC3\u5982\u679C\u611F\u9069\u8ACB\u4F11\u606F\uFF1A\u8457\u7DF4\u7FD2\u7A2E\u89BA\u61C9\u6703\u6D88\u5931\uFF0F\u89F8\u63A7\u677F\u5C07\u63A8\u8DF3\u8E8D\u5F97\u6108\u4E45\u5C31\u9AD8\u9577\u6293\u53D6\u5229\u5CA9\u67B6\u77F3\u9593\u7E2B\u9699\u6500\u722C\u82E5\u8981\u8DD1\u524D\u9032\u4EE5\u96D9\u624B\u6A21\u4EFF\u6B65\u4F5C\u770B\u60F3\u65B9\u4E26\u4F4F\u5404\u8868\u9762\u884C\u7246\u5FF5\u529B\u9B54\u6CD5\u4F38\u6B66\u5668\u76F4\u51FA\u73FE\u4EAE\u986F\u63A5\u5B83\u8209\u8EAB\u6709\u76AE\u5957\u651C\u5169\u80A9\u81C0\u90E8\u5B58\u653E\u5F85\u9B06\u81C2\u6E38\u6CF3\u7269\u54C1\u6B04\u80F8\u53E3\u6273\u6A5F\u62C9\u4E00\u5207\u90FD\u7531\u7406\u91CF\u9A45\u559C\u6B61\u6230\u9B25\u5F0F\u64CA\u6557\u6575\u4EBA\u7BA1\u7C97\u66B4\u9084\u56B4\u8B39\u901A\u6CBF\u5C0F\u8DEF\u8D70\u53BB\u6BD4\u8F03\u4F46\u8B93\u982D\u6688\u7E69\u7D22\u5F9E\u6ED1\u8F2A\u4EFB\u4F55\u639B\u4EF6\u548C\u5011\u7576\u7FFB\u8D8A\u81EA\u5DF1\u4E5F\u589E\u52A0\u984D\u5916\u8E72\u6084\u7121\u8072\u88AB\u767C\u60C5\u6CC1\u7E5E\u904E\u96B1\u653B\u58D3\u9677\u9631\u9580\u80CC\u5305\u5132\u65BC\u9054\u723E\u91CC\u4E9E\u88DD\u5177\u9650\u60A8\u7C3F\u542B\u6A19\u7C64\u85CF\u9801\u793A\u8CFC\u8CB7\u6240\u5019\u5BB6\u5712\u67D0\u5BA4\u5236\u5492\u8A9E\u505C\u7559\u6EFE\u64C7\u7A7A\u767D\u7167\u93E1\u5B50\u5099\u8863\u670D\u76D4\u7532\u5546\u5E97\u627E\u6B63\u78BA\u9AD4\u4F4D\u7A81\u4EA4\u63DB\u7136\u5F8C\u63E1\u7BAD\u7B99\u6E96\u8FCE\u6CE2\u22EF\uFF01\u62FF\u62F3\u59CB\u734E\u52F5\u8FD4\u56DE\u9810\u8A2D\u6B21\u5FAA\u74B0\u6C7A\u5B9A\u5B8C\u6210\u6700\u7D42\u751F\u4E8B\u9664\u5148\u7981\u6B62\u62FE\u6C60\u6280\u975E\u5BE6\u85E5\u8207\u7D44\u5408\u73A9\u9996\u6C99\u76D2\u5EA6\u9010\u5F37\u7372\u5141\u8A31\u4E14\u521D\u6C92\uFF08\uFF09\u7D2F\u7A4D\u6311\u4FDD\u5DF2\u76E4\u6BCF\u53EA\u5C08\u5C6C\u4E4B\u91CD\u7D93\u5178\u70BA\u8B77\u7B2C\u65B0\u8907\u9375\u6346\u7D81\u5730\u7A96\u6B64\u7522\u623F\u5FC5\u9808\u62B5\u52FE\u6A23\u964D\u4F4E\u591A\u6027\u8A02\u96E3\u50B7\u5BB3\u6E1B\u8F15\u76E1\u63EE\u592A\u64D4\u907F\u514D\u5C0D\u90A3\u4E9B\u610F\u7FA9\u8AAA\u56F0\u5FB9\u5E95\u516C\u5E73\u5F31\u537B\u8010\u6B7B\u4EA1\u534A\u91D1\u5E63\u547D\u7A0D\u5316\u9663\u89D2\u8272\u6C38\u9060\u5225\u8A18\u6839\u64DA\u8ABF\u6574\u67C4\u7B52\u5247\u5E6B\u52A9\u50CF\u885D\u523A\u7AF6\u5834\u9632\u56E0\u53D7\u800C\u8861\u6CE8\u5012\u817F\u5C24\u5176\u6548\u5C64\u7D1A\u4ED8\u9644\u528D\u5168\u7A7F\u9020\u503C\u6DFA\u5927\u7B97\u8853\u8EC0\u5E79\u9700\u8003\u616E\u54EA\u627F\u6295\u5C04\u554F\u984C\u7279\u76FE\u6301\u8B66\u6551\u80A2\u89E3\u719F\u7BC0\u9838\u5272\u7A69\u7CBE\u908A\u7DE3\u9F4A\u5617\u8A66\u821E\u578B\u5DEE\u65A7\u9396\u93C8\u8EDF\u900F\u5315\u7784\u64F2\u65E2\u61F2\u7F70\u5E2B\u65BD\u6062\u5FA9\u4ED4\u7D30\u98A8\u683C\u53E4\u8001\u6587\u660E\u4ED6\u5DE8\u795E\u79D8\u5EE2\u589F\u8FD1\u57C3\u767B\u52E2\u6975\u8208\u8DA3\u300C\u5F92\u300D\u7E54\u5718\u7E8C\u552F\u76EE\u74DC\u5206\u6676\u738B\u570B\u7375\u6BBA\u539F\u8352\u91CE\u6C11\u4FB5\u9818\u571F\u843D\u904D\u5E03\u4FE1\u4EF0\u7D71\u6CBB\u5716\u63A1\u6BB5\u904F\u5167\u65B7\u64F4\u6563\u773C\u6349\u6478\u5949\u4FD7\u5E0C\u671B\u69AE\u5149\u65A5\u7206\u70B8\u81A8\u8139\u6C23\u6CE1\u7DAD\u72C0\u614B\u7D66\u81F4\u5E45\u63D0\u5347\u920D\u5E38\u76CA\u905E\u529F\u7194\u878D\u96FB\u5F27\u77E2\u7A0B\u5674\u706B\u82B1\u65CB\u64C1\u88FD\u71C3\u71D2\u71FC\u7D50\u8086\u5FCC\u619A\u82E6\u6399\u624E\uFF1F\u731B\u70C8\u596A\u5203\u975C\u7E73\u68B0\u7130\u65D7\u9F13\u6797\u50B3\u6495\u88C2\u9739\u9742\u96F7\u84C4\u9583\u7BC4\u53CA\u8513\u5EF6\u8FFD\u8E64\u5F48\u5C0E\u7403\u6BB2\u6EC5\u9318\u985E\u8840\u8089\u7B49\u751A\u81F3\u7686\u4F9B\u8CA0\u5F71\u97FF\u96BB\u4F8B\u98DB\u5200\u5F13\u6756\u53E6\u52C1\u8E22\u4FEF\u6FC0\u6D41\u8AD6\u9802\u7AEF\u5634\u5DF4\u97F3\u544A\u670B\u53CB\u78C1\u9023\u8FF4\u93E2\u8E39\u5EA7\u638C\u963B\u64CB\u53CD\u8996\u52D9\u5883\u4FBF\u65AF\u7DDA\u78B0\u6728\u5076\u651D\u62CD\u622A\u5339\u77E5\u9053\u55CE\u8CFD\u65C5\u5EAB\u6578\u9435\u5320\u672A\u63CF\u8FF0\u8A73\u780D\u98FE\u904A\u66F8\u5B78\u8005\u5B97\u4E3B\u8F09\u675F\u6232\u8A08\u8CC7\u6599\u65AC\u5589\u7C89\u788E\u707C\u51B0\u51CD\u6BD2\u8017\u6D3B\u81FA\u7AD9\u6821\u7E3D\u7E8F\u6B77\u5343\u5E74\u7761\u7526\u722D\u6050\u6436\u5BF6\u5049\u72E9\u5354\u62DB\u52DF\u5F80\u5854\u6A13\u8B0E\u78E8\u63ED\u5BC6\u6372\u4F73\u8212\u9A57\u7ACB\u6E2C\u9B0D\u9AEE\u8155\u775B\u984F\u819A\u63A2\u50C5\u85C9\u8A13\u614E\u300A\u300B\u8857\u8A8D\u522A\u82F1\u5426\u7DE8\u8F2F\uFF0D\u8170\u8173\u8A0A\u7C21\u4ECB\u5361\u968E\u5075\u6539\u6F38\u6211\u5EFA\u8B70\u5C11\u771F\u7248\u672C\u822C\u8165\u5F62\u7537\u5973\u8A00\u500D\u756B\u8CEA\u62AC\u8DDD\u8292\u5F4E\u6307\u4F0F\u5C4D\u8D85\u7D0B\u6D77\u6D0B\u9670\u666F\u6389\u5E40\u79D2\u6A94\u632F\u66DD\u7DBB\u95BE\u92B3\u6E05\u898B\u6A02\u7A79\u589C\u640D\u6162\u649E\u5254\u9130\u906E\u6392\u5E8F\u6620\u8449\u9727\u661F\u96F2\u5C3C\u6234\u6163\u66A2\u786C\u6790\u7C92\u7CFB\u983B\u7387\u77DB\u68CD\u68D2\u7570\u5175\u58EB\u76DC\u8CCA\u9A0E\u50AD\u6B8A\u98DF\u5DE5\u9769\u5740\u9304\u8986\u5BEB\u5378\u96C6\u7E41\u884D\u5C55\u540D\u7A31\u8AA4\u5C1A\u68AF\u7247\u5C4B\u820A\u54E8\u57FA\u62F1\u6D1E\u7A74\u51F1\u6885\u8702\u5DE2\u52DD\u689D\u6B3E\u62D2\u7D55\u7E7C\u4FEE\u5D29\u58DE\u4EAB\u8B49\u652F\u63F4\u602A\u90F5\u5E33\u6236\u6536\u9001\u7BE9\u71B1\u5B89\u4ECA\u65E5\u95B1\u5275\u64F7\u671F\u87A2\u5E55\u78BC\u5323\u5783\u573E\u593E\u4EE3\u53F0\u5831\u903E\u4F3A\u5FD9\u789F\u8DB3\u7720\u5E8A\u92EA\u5047\u5427\u851A\u85CD\u5965\u9686\u77AC\u8B58\u6545\u5077\u968A\u6D3E\u5B57\u865F\u8A8C\u8B6F\u5211\u4E58\u5920\u523B\u667A\u6167\u57CE\u5E02\u696D\u7262\u919C\u964B\u8A3B\u79C1\u6467\u6BC0\u61F7\u7591\u8A71\u4E16\u754C\u6CDB\u6FEB\u8CAA\u5A6A\u6C42\u5FB7\u8150\u8A34\u7D0D\u59C6\u7D04\u74E6\u796D\u737B\u9AA8\u7070\u9858\u504F\u6848\u5F91\u8B80\u6DFB\u7EC4\u9009\u9879\u65F6\u53D1\u5F02\u4E0E\u620F\u517C\u514B\u99AC\u6069\u68EE\u71E7\u69CD\u7344\u904B\u592E\u89C0\u9014\u6EFF\u50BE\u5370\u7159\u654F\u767E\u5287\u5713\u898F\u96D6\u640F\u5CFD\u8C37\u6BBF\u6A4B\u6A11\u6CB3\u5821\u58D8\u5C71\u6A6B\u8DE8\u61F8\u5D16\u5B8F\u4F54\u93AE\u5EE3\u591C\u6DF1\u7199\u6518\u8056\u68C4\u79AE\u62DC\u6177\u6168\u7235\u5802\u585E\u71DF\u9928\u574A\u8DCB\u6D89\u8FF7\u5BAE\u751C\u871C\u5806\u907A\u7C4D\u79A6\u6EAA\u81E8\u5EAD\u9662\u963F\u7058\u76E3\u51A5\u5100\u5DEB\u8258\u64F1\u6B32\u71C8\u65C1\u9732\u584A\u9B6F\u8ECD\u5E7B\u79D1\u96DC\u4EE4\u5F81\u7DE9\u9A5A\u5DE7\u69CC\u5C16\u711A\u96F6\u790E\u6DF7\u4E82\u9748\u552E\u5E15\u8B1B\u6B0A\u5A01\u7687\u5979\u6771\u897F\u5473\u7B26\u7E6A\u8D95\u63D2\u81C9\u5929\u5BDF\u8FA6\u8070\u561B\u8F9B\u600E\u7368\u6628\u6F14\u5C37\u5C2C\u7661\u665A\u7126\u525D\u541E\u8541\u9EBB\u5237\u671D\u6562\u805E\uFF1B\u842C\u8AB0\u641E\u695A\u53C8\u86CB\u7E43\u7DCA\u8B20\u5925\u5F79\u9000\u7FA4\u611A\u8822\u8896\u76EF\u97AD\u9322\u92B7\u8D13\u72AF\u7B46\u916C\u7B28\u7926\u6B78\u807D\u4F01\u7ACA\u6233\u5967\u826F\u91AB\u7642\u505A\u5FCD\u6016\u6708\u6094\u6015\u7814\u7A76\u6190\u6982\u6B72\u5B69\u9418\u64CD\u7D05\u816B\u6C57\u96E8\u4F19\u67D4\u53EB\u75DB\u7671\u5269\u5438\u9846\u6838\u5D84\u4E09\u7B4B\u75B2\u5118\u52AA\u62EF\u9B42\u6BDB\u609A\u54E1\u4E94\u8116\u6CCA\u61FC\u9189\u72C2\u7B11\u6CBE\u9BAE\u5192\u5FAE\u7DD2\u986B\u6296\u53B2\u723D\u5947\u5145\u6085\u5C01\u7CDF\u75BC\u50F9\u6297\u5291\u526F\u6DEA\u5403\u8CBB\u5805\u85A9\u8AFE\u5766\u8D0A\u8CA9\u8CE3\u8EB2\u8C50\u5BCC\u865B\u582A\u6182\u5BC4\u75C5\u812B\u746A\u63DA\u5357\u5317\u6C83\u5144\u9867\u5BA2\u62FC\u62F7\u7AE5\u5509\u