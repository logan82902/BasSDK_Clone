    characterSetSelectionMode: 7
    characterSequence: "\u4F60\u5728\u4E25\u91CD\u635F\u6BC1\u7684\u8239\u4E2D\u9192\u6765\u3002\u5468\u56F4\u6C34\u57DF\u5341\u5206\u5371\u9669\u52C9\u5F3A\u62B5\u8FBE\u4E86\u5C9B\u4E0A\u5934\u6655\u76EE\u7729\u4E4B\u4E0B\uFF0C\u51E0\u4E4E\u5FD8\u8BB0\u81EA\u5DF1\u662F\u4E3A\u4F55\u5230\u6B64\u5904\u4E0D\u59A8\u53BB\u641C\u67E5\u4E00\u756A\u60A8\u968F\u65F6\u53EF\u4EE5\u6253\u5F00\u83DC\u5355\u68C0\u8F93\u5165\u60C5\u51B5\u3001\u66F4\u6539\u8BBE\u7F6E\u6216\u8005\u79BB\u8BE5\u533A\u6309\u952E\u518D\u6B21\u5373\u5173\u95ED\u4F7F\u7528\u5DE6\u6447\u6746\u56DB\u79FB\u52A8\u53F3\u8F6C\u5411\u5FEB\u901F\u80FD\u4F1A\u5F15\u53D1\u6076\u5FC3\u5982\u679C\u611F\u9002\u8BF7\u7ACB\u4F11\u606F\uFF1A\u5E94\u540E\u6D88\u5931\u89E6\u6478\u677F\u5C06\u5F80\u524D\u63A8\u8DF3\u8DC3\u5F97\u8D8A\u4E45\u9AD8\u957F\u6293\u53D6\u722C\u51F8\u51FA\u90E8\u5CA9\u77F3\u95F4\u7F1D\u9699\u8FDB\u53CC\u624B\u6A21\u62DF\u5954\u8DD1\u4F5C\u9644\u7740\u4E8E\u4EFB\u610F\u8868\u9762\u770B\u5E0C\u671B\u65B9\u501F\u52A9\u5899\u5F7C\u201C\u5FF5\u529B\u201D\u9B54\u6CD5\u4F38\u6B66\u5668\u7136\u4EAE\u663E\u793A\u9694\u7A7A\u62FF\u8D77\u8EAB\u6709\u4E2A\u76AE\u5957\u643A\u5E26\u80A9\u548C\u8170\u5404\u4E24\u677E\u5B58\u653E\u6E38\u6CF3\u52A0\u80F8\u7269\u54C1\u680F\u73B0\u6273\u673A\u8FD9\u4E16\u754C\u5207\u90FD\u9075\u4ECE\u5B66\u89C4\u5F8B\u9009\u62E9\u4EEA\u6218\u6597\u98CE\u683C\u8D25\u654C\u4EBA\u2014\u51ED\u5927\u86EE\u7CBE\u51C6\u800C\u5DE7\u5999\u653B\u51FB\u4E8C\u7686\u65E2\u7EB5\u4E5F\u6CBF\u9053\u8DEF\u8D70\u5EA6\u8F83\u4F46\u8BA9\u773C\u82B1\u4F4F\u7EF3\u7D22\u6ED1\u98DE\u8F6E\u5177\u5907\u7C7B\u4F3C\u9014\u4F53\u884C\u76F4\u63A5\u5229\u4E22\u53E3\u5176\u5F53\u6500\u60F3\u8981\u8FB9\u8FD8\u589E\u8E72\u4F0F\u5F0F\u53D8\u9690\u79D8\u5408\u795E\u77E5\u9B3C\u89C9\u5730\u7ED5\u8FC7\u6F5C\u8FD0\u79CD\u6D3B\u95E8\u80CC\u5305\u91CC\u83B7\u5E76\u50A8\u5C14\u4E9A\u88C5\u62E5\u65E0\u9650\u5BB9\u91CF\u901A\u5B83\u7C3F\u542B\u9879\u5361\u85CF\u8D2D\u4E70\u6240\u4EEC\u5BB6\u56ED\u5BA4\u63A7\u5236\u672F\u94AE\u60AC\u505C\u9700\u5492\u8BED\u767D\u7167\u955C\u5B50\u8863\u670D\u76D4\u7532\u5546\u5E97\u627E\u6B63\u786E\u4F4D\u7A81\u6362\u62A4\u67C4\u7BAD\u7B52\u5BF9\u6CE2\u52BF\u2026\uFF01\u4E3E\u62F3\u59CB\u5DF2\u5956\u52B1\u8FD4\u56DE\u9884\u5FAA\u73AF\u51B3\u5B9A\u5B8C\u6210\u6700\u7EC8\u751F\u4EC0\u4E48\u9664\u5148\u542F\u7981\u62FE\u6C60\u6280\u975E\u5B9E\u836F\u4EF6\u6346\u7ED1\u76F8\u73A9\u7B2C\u6C99\u76D2\u9010\u6B65\u63D0\u5347\u4E14\u521D\uFF08\uFF09\u79EF\u7D2F\u6311\u4FDD\u7559\u76D8\u6BCF\u53EA\u7ECF\u5178\u4EC5\u65B0\u590D\u7262\u96BE\u7B49\u7EA7\u623F\u6570\u9047\u5FC5\u987B\u624D\u52FE\u964D\u4F4E\u591A\u6837\u6027\u4E49\u7531\u7B80\u53D7\u4F24\u5BB3\u523B\u6CE8\u8EB2\u907F\u666E\u5747\u8861\u56F0\u5E38\u516C\u5E73\u5F31\u5C0F\u5374\u987D\u6B7B\u4EA1\u534A\u91D1\u5E01\u547D\u989D\u5916\u6761\u65E6\u89D2\u8272\u4FBF\u522B\u559C\u597D\u8C03\u6574\u5378\u63E1\u767B\u505A\u51B2\u523A\u6BD4\u70B9\u7ADE\u573A\u9635\u5C31\u56E0\u627F\u6CA1\u5BDF\u6613\u88AB\u5012\u817F\u6548\u4ED8\u6301\u7EED\u4E0E\u6D45\u5251\u7A7F\u5F88\u8EAF\u5E72\u81C2\u514D\u6295\u5C04\u7ED9\u9020\u9EBB\u70E6\u7279\u76FE\u724C\u8B66\u60D5\u80A2\u89E3\u8282\u9888\u53CA\u5F71\u54CD\u7387\u7A33\u5065\u8BD5\u56FE\u6325\u578B\u4E8B\u613F\u8FDD\u65A7\u94FE\u67D4\u8F6F\u5315\u9996\u8F7B\u63B7\u8D64\u88F8\u60E9\u7F5A\u5E08\u65BD\u4E13\u503C\u52A1\u8C28\u614E\u66FE\u53E4\u4EE3\u5EFA\u8F89\u714C\u6587\u660E\u90A3\u4E9B\u5E9E\u5E9F\u589F\u4ED6\u9057\u4EA7\u8FD1\u57C3\u62C9\u5BC6\u5F92\u6563\u7EC4\u7EC7\u990D\u8DB3\u96C6\u6676\u906D\u738B\u56FD\u8FFD\u6355\u7EF4\u7CFB\u552F\u6807\u8352\u91CE\u6C11\u4FB5\u9886\u571F\u843D\u8001\u4FE1\u4EF0\u904D\u5E03\u4E3B\u5BB0\u60DC\u6BB5\u904F\u5883\u5185\u4F20\u64AD\u80A1\u83AB\u6D4B\u6BEB\u5FCC\u8BB3\u6062\u5D07\u65A5\u7206\u70B8\u9001\u81A8\u80C0\u6C14\u6CE1\u5E45\u5EF6\u6781\u72B6\u6001\u9677\u9631\u5427\u949D\u5168\u671F\u9646\u9012\u51CF\u77E2\u7194\u878D\u7535\u5F27\u8FDC\u7A0B\u706B\u65CB\u661F\u6E85\u6697\u987E\u8651\u8F99\uFF1F\u731B\u70C8\u593A\u5203\u9759\u7F34\u68B0\u8106\u7130\u65D7\u9F13\u914D\u6797\u79C0\u6495\u65AD\u84C4\u9739\u96F3\u96F7\u95EA\u6269\u8303\u5219\u4EE4\u52B2\u8513\u71C3\u707C\u70E7\u8E2A\u5F39\u7403\u6B7C\u706D\u9489\u9524\u9501\u6536\u751A\u5FAE\u8089\u9632\u867D\u4F9B\u7406\u62D6\u6162\u5200\u5F13\u6756\u53E6\u8E22\u4FEF\u7EDD\u4F73\u6FC0\u6D41\u9876\u7AEF\u671D\u6307\u5E95\u5634\u5DF4\u963B\u6B62\u58F0\u60CA\u540C\u4F34\u78C1\u5C5E\u4F8B\u9556\u7ED3\u5750\u6321\u53CD\u89C6\u89C2\u516D\u64CD\u5343\u4E07\u6211\u78B0\u65AF\u5BFC\u7EBF\u6728\u5076\u628A\u622A\u5C4F\u544A\u95EE\u9898\u5339\u50CF\u5426\u7EE7\u8D5B\u65C5\u9ED8\u8BA4\u5E93\u6C42\u94C1\u5320\u672A\u63CF\u8FF0\u8BE6\u5288\u780D\u9970\u5242\u6297\u6D6A\u6F6E\u4E66\u5B97\u8F7D\u9000\u620F\u636E\u65A9\u5272\u5589\u8116\u811A\u7C89\u788E\u51BB\u6BD2\u67B6\u5C3D\u675F\u5EA7\u5141\u8BB8\u7AD9\u4FA7\u6821\u603B\u6982\u9A8C\u72E9\u730E\u6C89\u7761\u5E74\u82CF\u7EB7\u6E34\u73CD\u8D35\u5B9D\u6D69\u534F\u59D4\u6258\u6247\u5145\u6EE1\u5854\u638C\u78E8\u7EC3\u63ED\u6EDA\u8212\u80E1\u8155\u652F\u775B\u989C\u80A4\u5E8F\u63A2\u5267\u900F\u5F20\u300A\u300B\u8857\u5220\u82F1\u7F16\u8F91\u8DDF\u81F3\u6863\u6559\u7EDF\u5B89\u6DFB\u539F\u6C41\u5473\u8BAE\u5C11\u6237\u8840\u8FF9\u97F3\u7537\u5973\u8A00\u500D\u6DF7\u753B\u8D28\u8DDD\u5149\u9488\u5C38\u6DB2\u81F4\u8D85\u91C7\u6E32\u67D3\u7EB9\u9634\u8D34\u5E27\u8BA1\u79D2\u6848\u9971\u66DD\u6CDB\u9608\u9510\u5316\u5F03\u6E05\u89C1\u4E50\u5F0A\u5929\u7A79\u5760\u7F13\u649E\u90BB\u585E\u6811\u53F6\u96FE\u626D\u66F2\u6052\u4E91\u7F29\u6234\u60EF\u77AC\u575A\u786C\u8FA8\u6DE1\u5F85\u8FDE\u7C92\u5237\u67AA\u77DB\u68CD\u6B8A\u62DB\u52DF\u58EB\u532A\u9A91\u4F63\u5175\u8017\u98DF\u5DE5\u8D44\u6E90\u5F55\u8986\u76D6\u5598\u540D\u79F0\u9519\u8BEF\u68AF\u6D53\u6545\u4E61\u697C\u5C4B\u5CAC\u65E7\u54E8\u62F1\u6D1E\u7A74\u51EF\u6885\u6D77\u8702\u5DE2\u80DC\u4F18\u6B3E\u62D2\u4EAB\u8BEB\u72EC\u62C5\u529F\u8BC1\u6F0F\u67D0\u5F02\u6389\u521B\u90AE\u7BB1\u5740\u8D26\u53F7\u4EA4\u7B5B\u70ED\u4ECB\u7ECD\u7248\u672C\u4ECA\u65E5\u8BA2\u9605\u7B7E\u7A0D\u8BFB\u5269\u4F59\u7801\u5783\u573E\u5BFB\u53F0\u62A5\u7E41\u5FD9\u5E8A\u6742\u795D\u6109\u78A7\u84DD\u5965\u9686\u8BC6\u666F\u8D43\u5458\u771F\u5B57\u5E55\u5FD7\u7FFB\u8BD1\u6C38\u6740\u5DE8\u8BAD\u5C1A\u5047\u5C42\u57CE\u5E02\u4E1A\u4E11\u964B\u79C1\u6000\u7591\u8BDD\u6EE5\u8D2A\u5A6A\u5FB7\u8150\u8BC9\u7EB3\u59C6\u7EA6\u74E6\u796D\u732E\u9AA8\u7070\u7EC6\u504F\u5DEE\u5F84\u517C\u5417\u514B\u9A6C\u6069\u68EE\u71E7\u8BF8\u72F1\u9875\u592E\u70DF\u819B\u7075\u654F\u6D4F\u89C8\u591C\u665A\u767E\u6F14\u4FEE\u5706\u5F62\u5CE1\u8C37\u5E99\u6865\u6CB3\u4F9D\u5C71\u6A2A\u8DE8\u5D16\u6881\u5B8F\u4F1F\u8E1E\u5077\u9547\u5E7F\u6674\u6717\u9633\u6DF1\u7199\u6518\u5723\u6BBF\u62DC\u6177\u6168\u7235\u5802\u5821\u5792\u8425\u9986\u574A\u53C8\u8FF7\u5BAB\u5806\u7C4D\u5FA1\u6EAA\u4E34\u5EAD\u9662\u5949\u963F\u793C\u6EE9\u76D1\u51A5\u5DEB\u8258\u6401\u6B32\u706F\u65C1\u88C2\u9732\u5757\u9C81\u8F66\u574D\u584C\u5ECA\u5CB8\u535A\u57FA\u5C55\u70BC\u5382\u5143\u5385\u7089\u5851\u575B\u7565\u6F20\u5584\u4F69\u5947\u5E7B\u79D1\u7247\u9A71\u5F7B\u5C16\u8FEB\u5C48\u5A01\u4E60\u7840\u4E71\u552E\u8003\u5E15\u8BF4\u51E1\u6BCD\u864E\u965B\u6D3E\u4E1C\u897F\u80AF\u94B1\u4ED4\u695A\u62A2\u6377\u4FA6\u64C5\u52D8\u4F3A\u4EB2\u5566\u8BBA\u6628\u95F9\u75F4\u7126\u8368\u6469\u64E6\u8138\u5C45\u95FB\u9636\u4F17\u8D3C\u513F\u86CB\u8C01\u5F1F\u5144\u5386\u5F79\u961F\u7B28\u5C01\u8C23\u97AD\u5019\u9500\u77FF\u60E6\u5F52\u542C\u6562\u4FA5\u5E78\u9003\u826F\u533B\u7597\u6551\u60E8\u5FCD\u7779\u7687\u6708\u6094\u592A\u6015\u7814\u7A76\u529E\u5E2E\u601C\u5B69\u5C81\u949F\u6D51\u7EA2\u6C57\u4F19\u65E9\u5413\u53EB\u75DB\u82E6\u70EC\u5438\u6838\u5979\u7D27\u4E09\u7B4B\u75B2\u7AED\u7B56\u5938\u6050\u6016\u5BF8\u6C61\u6B8B\u5BD2\u6817\u4EA2\u594B\u8C61\u72C2\u7B11\u600E\u5106\u5C24\u826E\u5F99\u5199\u5389\u554A\u723D\u54B8\u6BDB\u4E19\u8096\u7533\u9752\u5BFA\u5356\u75BC\u7545\u8010\u8D1F\u6E10\u7BA1\u62D4\u591F\u52AA\u6BC5\u637A\u8270\u4E89\u7B97\u76D7\u8428\u8BFA\u5766\u8D38\u633D\u5C1D\u7ADF\u4E30\u5BCC\u7B14\u9760\u5192\u633A\u865A\u77E3\u75C5\u5BC4\u8131\u739B\u626C\u5357\u5317\u6C83\u6298\u8C31\u8FC5\u6073\u8230\u66B4\u62E6\u653F\u4EF7\u679A\u6279\u8BE2\u88C1\u8865\u507F\u9891\u539A\u916C\u8109\u6845\u7B1E\u8058\u7A83\u7EDE\u5211\u9648\u54A8\u5FE0\u72E1\u8BC8\u65CF\u51FF\u8D23\u5582\u9F20\u8361\u8231\u8822\u8D27\u9976\u626A\u9A6F\u7AE0\u7F04\u4E9F\u5FE7\u7792\u667A\u519B\u6795\u6208\u6349\u8D29\u75AF\u94E4\u9080\u6467\u632B\u529D\u719F\u8E81\u8F84\u8680\u8C13\u9ED1\u54B1\u7B54\u6025\u8C05\u53DB\u6D17\u8054\u670B\u53CB\u8D39\u4F26\u6CF0\u5C3C\u61BE\u8C0B\u5212\u6743\u4F01\u8F88\u656C\u5BA3\u8BDA\u5F81\u6D1B\u7586\u6CBB\u94BB\u54EA\u5BBD\u63EA\u9F99\u5377\u5174\u8DA3\u7ED8\u52B3\u6B22\u8FCE\u5171\u987F\u4E58\u8C22\u5170\u6C0F\u4F0A\u592B\u51B0\u51B7\u82D4\u6652\u80BF\u9065\u8D6B\u7720\u602A\u6BD5\u4E95\u5D29\u6790\u822C\u7530\u60E7\u4F50\u8A93\u53C2\u641E\u68A6\u7956\u7948\u7977\u60B2\u6CE3\u8363\u6599\u52C7\u6839\u6012\u538B\u810F\u9706\u97E7\u5BBF\u80DE\u8000\u8292\u5B9C\u5409\u6D25\u745E\u8302\u6B86\u614C\u7231\u76FC\u7F8E\u8944\u76DB\u59D0\u59B9\u76DF\u4E18\u90D1\u6C47\u9887\u5E86\u6625\u6B4C\u5EF7\u594F\u5DE9\u56FA\u9882\u5C60\u795F\u72AF\u660F\u8111\u6270\u53EC\u57CB\u8165\u53E5\u9152\u676F\u8BA8\u8D5E\u7834\u5974\u5450\u558A\u88AD\u987A\u64A4\u524A\u6CE5\u9B41\u68A7\u4EFF\u4F5B\u5B54\u6816\u6089\u94F8\u8D60\u4E88\u6751\u7EAF\u7CB9\u5448\u91CA\u80C6\u642C\u9707\u7838\u70F9\u996A\u51AC\u6E29\u6696\u590F\u708E\u754F\u6682\u55B7\u821E\u950B\u6C72\u62EC\u7FBD\u8FC2\u98D8\u6D6E\u627C\u7A92\u7784\u9525\u901D\u72E0\u6454\u8457\u77ED\u7ECA\u6F29\u6DA1\u5524\u9897\u8DE4\u7529\u58C1\u62E2\u9668\u96F6\u503E\u7FA4\u5F2F\u606D\u52A3\u7891\u83B1\u632F\u7C73\u798F\u547C\u6392\u9988\u6D01\u8BDE\u5988\u574F\u5446\u561B\u6291\u521A\u5360\u7F62\u5BC2\u903C\u62B1\u6028\u5462\u8FB0\u5509\u888B\u6D4A\u5C18\u67F1\u8D2F\u4FF1\u4EC6\u51C0\u956F\u9B42\u8D22\u7EAA\u96D5\u72ED\u7A84\u6F06\u6C9F\u4ECD\u601D\u6CBE\u6784\u536B\u9F50\u56E2\u4F0D\u9645\u582A\u52E4\u5835\u8E29\u6284\u5915\u75D5\u6D89\u6F2B\u4E4F\u8482\u538C\u6491\u62E8\u7F3A\u5217\u7D20\u6EAF\u67AF\u6BD9\u4E94\u5384\u7980\u8D4B\u8403\u90AA\u62EF\u4E1D\u788D\u540A\u62FC\u51D1\u611A\u80C1\u8C08\u7741\u7A8D\u79C9\u8E0F\u586B\u64BC\u7B51\u6C49\u8D1D\u745F\u7EBD\u5662\u8D50\u5B81\u60D1\u4EC7\u6068\u5146\u63F4\u5439\u62C2\u5179\u8C0E\u60AF\u634F\u51DD\u72B9\u62CD\u805A\u6B47\u8BF2\u54ED\u60BC\u8C10\u6388\u8BFE\u5B87\u5B99\u54C0\u8FC8\u53F2\u5018\u82E5\u5937\u5FF1\u6653\u663C\u70AB\u5531\u8BCD\u8F9B\u53F8\u8D8B\u9274\u8F68\u4F30\u2013\u5BA1\u501A\u8FA9\u5C0A\u5B98\u5BA2\u804C\u5FFD\u5B88\u54CE\u5440\u5443\u77E9\u61C2\u5514\u60F9\u8C0D\u4EFD\u50DA\u6405\u7CCA\u6D82\u5367\u8D21\u8BB2\u7701\u82AF\u68D2\u6267\u5370\u7763\u8BC4\u5484\u2018\u2019\u7968\u7B26\u82CD\u6B49\u6320\u793E\u762B\u75EA\u5F17\u6170\u52D2\u80F3\u818A\u64AC\u78BE\u9A87\u5B59\u5F04\u62C6\u57F9\u518C\u526F\u7F51\u7EDC\u969C\u5F25\u53E0\u5FC6\u6DC6\u6CB8\u817E\u7F79\u60A3\u76CA\u5455\u6CA5\u7B79\u63AA\u903B\u7EF5\u5265\u5984\u80FC\u80DD\u86DB\u63E3\u6492\u6167\u6B3A\u9A97\u6CA6\u8336\u996D\u8D3E\u6B20\u64B0\u85AA\u626E\u8BBF\u5815\u9965\u8BF1\u7CDF\u7CD5\u8083\u727A\u7272\u707E\u7F55\u5708\u68F1\u4FD7\u4E92\u6EA2\u711A\u7316\u7357\u7518\u9685\u6E1D\u9063\u9EBE\u8D74\u6ECB\u5CFB\u7A3D\u631A\u673D\u76D0\u4EA6\u837C\u7F14\u5AE1\u88D4\u8654\u6566\u4FC3\u8446\u6DA4\u5C65\u6084\u51FD\u9006\u5609\u9038\u7F6A\u7F81\u62BC\u9610\u89D0\u8BCF\u94ED\u5E1C\u9A7E\u6063\u5BE5\u9A6D\u5353\u70FD\u52AB\u6398\u7978\u541E\u566C\u51CB\u62B9\u63A9\u6070\u9022\u7EE9\u8D24\u6108\u62D8\u7BC7\u7AE5\u96C4\u8F9F\u8E4A\u53E9\u8E4B\u75AE\u75CD\u8715\u4EC1\u59D1\u684E\u688F\u4F2A\u819C\u6148\u5B7D\u51DB\u51BD\u96E8\u50B2\u5D1B\u96EA\u7F09\u64D2\u8D4F\uFF1B\u6E7F\u6CDE\u5403\u997C\u829C\u6B23\u88F9\u53F9\u822A\u8FC1\u5B63\u751C\u60CB\u6DA8\u6CC9\u788C\u8870\u8877\u60A6\u6055\u7F15\u5F69\u62BD\u8BAF\u515C\u59D3\u662D\u809A\u606A\u5C09\u8F96\u6E17\u622E\u7F72\u98A0\u7EEA\u51C4\u7A1A\u5AE9\u9ABC\u5C3E\u82DF\u8F9C\u5669\u7D2B\u7F2D\u4E03\u51CC\u8151\u52FF